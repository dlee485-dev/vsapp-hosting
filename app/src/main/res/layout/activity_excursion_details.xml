<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.ExcursionDetails"
    android:paddingTop="?attr/actionBarSize">

    <!-- Top toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/excursionToolbar"
        android:layout_width="0dp"
        android:paddingTop="24dp"
        android:layout_height="?attr/actionBarSize"
        app:title="Excursion Details"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Content container BELOW the toolbar -->
    <LinearLayout
        android:id="@+id/excursionContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/excursionToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Excursion title label -->
        <TextView
            android:id="@+id/excursionTitleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Excursion Title:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Excursion title input -->
        <EditText
            android:id="@+id/excursionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cycling" />

        <!-- Date label -->
        <TextView
            android:id="@+id/excursionDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="Date:"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Date field (TextView used like a button) -->
        <TextView
            android:id="@+id/excursionDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="Select Date" />

        <!-- Save button -->
        <Button
            android:id="@+id/saveExcursionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Save Excursion" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
